{
  "expo": {
    "name": "Controls BLE Sensor Emulator",
    "slug": "controls-ble-sensor-emulator",
    "version": "1.0.0",
    "scheme": "controls-ble-sensor-emulator",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.conifertechnologies.controlsbleemulator",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow this iPhone to advertise the sensor emulator and send sensor samples to your MacBook over Bluetooth."
      }
    },
    "plugins": ["expo-dev-client", "./plugins/withQuotedIosBundleScript", "./plugins/withDisabledScriptSandboxing", "./plugins/withIosSceneLifecycle"]
  }
}
