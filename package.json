{
  "name": "controls-ble-sensor-emulator",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:prebuild": "expo prebuild --platform ios --no-install",
    "test": "jest --runInBand",
    "test:native": "bash scripts/test-native-ble.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-dev-client": "~57.0.20",
    "expo-modules-core": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
